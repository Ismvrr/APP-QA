# =============================================================================
# QAIA FastAPI — Variables de entorno (copiar a .env y llenar)
# =============================================================================

# DATABASE
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=tu_usuario_bd
DB_PASS=tu_password_bd
DB_NAME=tu_base_de_datos

# Chat2Desk
C2D_BASE_URL=https://api.chat2desk.com.mx/v1
C2D_WEB_URL=https://web.chat2desk.com.mx
C2D_DEFAULT_TOKEN=tu_token_c2d

# Gemini (IA) — solo necesaria para sección Análisis IA
GEMINI_API_KEY=tu_api_key_gemini
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_ENABLED=false

# JWT — DEBE ser idéntico al JWT_SECRET en Laravel .env
JWT_SECRET=cambia_esto_en_produccion
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=480
